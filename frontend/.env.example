# ==========================================
# MediFlow Frontend Environment Configuration
# ==========================================

# Backend API URL (optional):
# - In local dev (Vite proxy) or Vercel Full-Stack: leave blank or commented out.
# - If backend is deployed separately (e.g. Render, Railway, AWS, Fly.io):
# VITE_API_URL=https://mediflow-backend.onrender.com

# WebSocket URL (optional):
# - In local dev: defaults to ws://localhost:5173/ws (proxied to backend)
# - In production with separate backend:
# VITE_WS_URL=wss://mediflow-backend.onrender.com/ws
