# ==========================================
# MediFlow Environment Configuration
# ==========================================

# Backend Settings
PROJECT_NAME="MediFlow — Smart Hospital Bed & Patient Allocation System"
SECRET_KEY="mediflow_super_secure_jwt_secret_key_2026_dev"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For Docker / PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediflow"

# For SQLite zero-config local run:
# DATABASE_URL="sqlite:///./mediflow.db"

# For Vercel Serverless (auto-defaults to /tmp/mediflow.db if unset):
# DATABASE_URL="sqlite:////tmp/mediflow.db"

# Docker Compose DB Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mediflow

# Frontend Environment Variables (for Vercel deployment)
# Leave empty if deploying fullstack to Vercel (uses relative /api proxy)
# Set if backend is deployed separately on Render / Railway / Fly.io:
# VITE_API_URL="https://your-backend-api.railway.app"
# VITE_WS_URL="wss://your-backend-api.railway.app/ws"
